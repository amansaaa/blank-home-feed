{
  "manifest_version": 3,
  "name": "Blank Home Feed",
  "description": "Hides the recommendation feed on the YouTube homepage.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "css": ["block.css"],
      "run_at": "document_start"
    }
  ]
}
